<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Remove index.php from URL
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

# Security (OPTIONNEL)
<FilesMatch "\.(htaccess|env|log|sql)$">
    Require all denied
</FilesMatch>