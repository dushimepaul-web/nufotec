# Site compilé (dossier dist/) servi par Apache. Copié tel quel par « npm run build ».

# Adresses de l'application (React) : /admin, /medecin et /login -> admin.html ; le reste -> index.html
RewriteEngine On

# Images WebP : img/photo.jpg.webp servie à la place de img/photo.jpg si le navigateur l'accepte
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{REQUEST_FILENAME} \.(jpe?g|png)$ [NC]
RewriteCond %{REQUEST_FILENAME}.webp -f
RewriteRule ^(.+)$ $1.webp [T=image/webp,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(admin|medecin|login)(/.*)?$ admin.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [L]

Options -Indexes
AddType image/webp .webp

<IfModule mod_headers.c>
  # Sécurité : pas d'affichage dans une iframe d'un autre site, pas de devinette du type de fichier
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), payment=()"
  # HTTPS obligatoire une fois le site en ligne avec un certificat (à décommenter en production)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Rapidité : les fichiers de assets/ portent une empreinte dans leur nom -> cache d'un an
  <FilesMatch "\.(js|css|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Les pages HTML sont toujours revalidées : une nouvelle version du site est visible tout de suite
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|webp)$">
    Header append Vary Accept
  </FilesMatch>
</IfModule>

# Compression gzip des fichiers texte (60 à 80 % de données en moins sur les connexions lentes)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>
