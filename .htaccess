RewriteEngine On
RewriteBase /

# ============================================
# WEBSOCKET PROXY
# ============================================
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^socket/(.*) ws://127.0.0.1:3002/socket/$1 [P,L]

RewriteRule ^socket/(.*) http://127.0.0.1:3002/socket/$1 [P,L]

# ============================================
# RÈGLES POUR LES LANGUES (CORRECTION POUR LITESPEED)
# ============================================
# Version LiteSpeed sans ? dans l'URL
RewriteRule ^(fr|en|ar|sw)$ index.php/$1 [L,QSA]
RewriteRule ^(fr|en|ar|sw)/(.*)$ index.php/$1/$2 [L,QSA]

# ============================================
# CODEIGNITER POUR LITESPEED
# ============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L,QSA]

# ============================================
# EN-TÊTES
# ============================================
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Upgrade, Connection"
</IfModule>