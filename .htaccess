RewriteEngine On

# ============================================================
# 1. PONT VERS NODE.JS - VERSION CORRIGÉE
# ============================================================
<IfModule mod_proxy.c>
    # Conserver le chemin complet /socket/
    RewriteRule ^socket/(.*) http://127.0.0.1:3002/socket/$1 [P,L]
    ProxyPassReverse /socket/ http://127.0.0.1:3002/socket/
</IfModule>

# ============================================================
# 2. RÈGLES CODEIGNITER
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]