RewriteEngine On

# ============================================
# NE RIEN FAIRE D'AUTRE - JUSTE PROXY HTTP
# ============================================
# Pas de WebSocket, pas de condition spéciale
RewriteRule ^socket/(.*)$ http://127.0.0.1:3002/socket/$1 [P,L]

# CodeIgniter
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]