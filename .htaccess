RewriteEngine On

# ============================================
# WEBSOCKET PROXY - DOIT ÊTRE EN PREMIER
# ============================================
# Détecter la mise à niveau WebSocket
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^socket/(.*) ws://127.0.0.1:3002/socket/$1 [P,L]

# ============================================
# PROXY HTTP NORMAL
# ============================================
RewriteRule ^socket/(.*) http://127.0.0.1:3002/socket/$1 [P,L]

# ============================================
# REDIRECTION DE LA RACINE VERS /fr
# ============================================
RewriteRule ^$ /fr [L,R=301]

# ============================================
# ROUTES MULTILINGUES POUR CODEIGNITER
# ============================================
# Si le fichier ou dossier existe, ne pas réécrire
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Routes avec préfixe langue (fr, en, ar, sw)
RewriteRule ^(fr|en|ar|sw)(/.*)?$ index.php/$1$2 [L,QSA]

# Toutes les autres requêtes
RewriteRule ^(.*)$ index.php/$1 [L,QSA]

# ============================================
# EN-TÊTES POUR WEBSOCKET
# ============================================
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Upgrade, Connection"
</IfModule>