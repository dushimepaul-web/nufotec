APP_NAME=Nufotec API
APP_ENV=local
DEBUG=true
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/nufotec_db?charset=utf8mb4
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=*

# Emails : console (dev, rien n'est envoyé) ou smtp
MAIL_MODE=console
MAIL_FROM=nufotecburundi2026@gmail.com
MAIL_FROM_NAME=Nufotec
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=nufotecburundi2026@gmail.com
SMTP_PASSWORD=
TRUSTED_PROXIES=127.0.0.1,::1
DEFAULT_PHONE_REGION=BI
UPLOADS_DIR=C:\wamp64\www\nufotec\backend\attachments
MEDIA_BASE_URL=http://localhost/nufotec/backend/attachments
PUBLIC_API_URL=http://127.0.0.1:8000

# Chiffrement des clés d'IA (Fernet, 32 octets en base64). À sauvegarder : sans elle, les clés stockées sont illisibles.
AI_ENCRYPTION_KEY=

# Base de données : délais (secondes) et taille du groupe de connexions
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=60
# Sauvegardes (tools.backup_db) : dossier de destination, à copier ensuite sur un autre disque ou une autre machine
# BACKUP_DIR=D:\sauvegardes\nufotec
